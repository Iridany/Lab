<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.converter.controller.ConverterController"
      prefWidth="450" prefHeight="400"
      style="-fx-background-color: #FFF8E7; -fx-padding: 20;">

    <Label text="Конвертер кулинарных единиц"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6A0DAD;"/>

    <Label text="Перевод единиц для рецептов"
           style="-fx-font-size: 12px; -fx-text-fill: #9370DB; -fx-padding: 0 0 10 0;"/>

    <HBox spacing="10" alignment="CENTER">
        <Label text="Значение:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6A0DAD;"/>
        <TextField fx:id="inputField" promptText="Введите число"
                   style="-fx-background-color: #FFFACD; -fx-border-color: #DDA0DD; -fx-border-radius: 5px; -fx-padding: 5px;"
                   prefWidth="200"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Label text="Из:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6A0DAD;" prefWidth="50"/>
        <ComboBox fx:id="fromUnit"
                  style="-fx-background-color: #FFFACD; -fx-border-color: #DDA0DD; -fx-border-radius: 5px;"
                  prefWidth="250"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Label text="В:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6A0DAD;" prefWidth="50"/>
        <ComboBox fx:id="toUnit"
                  style="-fx-background-color: #FFFACD; -fx-border-color: #DDA0DD; -fx-border-radius: 5px;"
                  prefWidth="250"/>
    </HBox>

    <Button fx:id="convertButton" text="Конвертировать"
            onAction="#handleConvert"
            style="-fx-background-color: #6A0DAD; -fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;"/>

    <VBox alignment="CENTER" spacing="5"
          style="-fx-background-color: #F3E5F5; -fx-border-radius: 10; -fx-padding: 10;">
        <Label text="Результат:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6A0DAD;"/>
        <Label fx:id="resultLabel" text="—"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FF8C00;"/>
        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill: #FF4500; -fx-font-size: 12px;"/>
    </VBox>

</VBox>